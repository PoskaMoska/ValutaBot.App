<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CA2007: ConfigureAwait — не актуально для ASP.NET Core Exe (нет SynchronizationContext) -->
    <!-- CA1062: Null-checks для публичных параметров — избыточны при nullable annotations -->
    <!-- CA1031: catch(Exception) — намеренный паттерн в сервисах высокой надёжности -->
    <!-- CA1303/CA1304/CA1305/CA1310: Строковая локализация — не нужна для торгового бота -->
    <!-- CA1034: Вложенные типы — намеренный паттерн архитектуры -->
    <NoWarn>$(NoWarn);CA2007;CA1062;CA1031;CA1303;CA1304;CA1305;CA1310;CA1034</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="MiniApp/wwwroot/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <Compile Remove="Benchmarks\**" />
    <Compile Remove="RefactorTool\**" />
    <Content Remove="Tests\**" />
    <Content Remove="Benchmarks\**" />
    <Content Remove="RefactorTool\**" />
    <None Remove="Tests\**" />
    <None Remove="Benchmarks\**" />
    <None Remove="RefactorTool\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Polly" Version="8.5.2" />
    <PackageReference Include="Telegram.Bot" Version="19.0.0" />
    <PackageReference Include="prometheus-net" Version="6.0.0" />
  </ItemGroup>
</Project>

